{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/gsoli_setup.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/gsoli_setup.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_scaffold.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/check_scaffold.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
